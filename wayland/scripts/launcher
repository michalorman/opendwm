#!/bin/sh
# launcher [drun|run]
# Use the shared Wayland-native Bemenu styling for both launcher modes.
set -u

mode=${1:-drun}
case $mode in drun | run) ;; *)
  echo "launcher: mode must be drun or run" >&2
  exit 1
  ;;
esac

fail() {
  notify-send "launcher" "$1" 2>/dev/null || printf 'launcher: %s\n' "$1" >&2
  exit 1
}

if [ "$mode" = drun ]; then
  if command -v j4-dmenu-desktop >/dev/null && command -v bemenu-menu >/dev/null; then
    exec j4-dmenu-desktop --dmenu='bemenu-menu --launcher'
  fi
  fail "no drun launcher found (j4-dmenu-desktop+bemenu-menu)"
else
  if command -v bemenu-menu >/dev/null; then
    exec bemenu-menu --launcher --run
  fi
  fail "no run launcher found (bemenu-menu)"
fi
